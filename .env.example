# Used by `docker compose up` for the local stack.
# The deployed setup configures each service in its own hosting dashboard —
# see backend/nest/.env.example and frontend/.env.example.

POSTGRES_DB=orbit
POSTGRES_USER=orbit
POSTGRES_PASSWORD=orbit

# Any long random string. Rotating it invalidates every issued token.
JWT_SECRET=local-development-secret-do-not-use-in-production

NEXT_PUBLIC_API_URL=http://localhost:8080/api
